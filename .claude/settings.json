{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Edit(./.env)",
      "Edit(./.env.*)"
    ],
    "ask": [
      "Edit(./.github/workflows/**)",
      "Write(./.github/workflows/**)",
      "Edit(./config/limites.json)",
      "Write(./config/limites.json)",
      "Edit(./CLAUDE.md)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/bloquear.sh\""
          }
        ]
      }
    ]
  }
}
